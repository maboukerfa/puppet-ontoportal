# @summary Second mgrep server annotating against the lemmatized dictionary.
#
# ncbo_cron writes dictionary-lem.txt next to dictionary.txt; the API queries
# mgrep (55555) for exact matches and mgrep-lem (55557) for lemmatized ones.
#
# @param port Port the server listens on.
# @param dict_path Lemmatized dictionary generated by ncbo_cron.
# @param user Service account, shared with mgrep.
# @param group Group that may write the dictionary.
class ontoportal::mgrep_lem (
  Stdlib::Port $port              = 55557,
  Stdlib::Absolutepath $dict_path = '/srv/ontoportal/data/mgrep/dictionary/dictionary-lem.txt',
  String $user                    = 'mgrep',
  String $group                   = 'ontoportal',
) {
  # mgrep refuses to start without a dictionary; ncbo_cron replaces this sample
  file { $dict_path:
    replace => false,
    source  => 'puppet:///modules/mgrep/sample_dictionary.txt',
    mode    => '0664',
    owner   => $user,
    group   => $group,
    require => Class['mgrep'],
  }

  systemd::unit_file { 'mgrep-lem.service':
    content => epp('mgrep/mgrep.service.epp', {
        'user'       => $user,
        'group'      => $group,
        'port'       => $port,
        'mgrep_dict' => $dict_path,
    }),
  }
  ~> service { 'mgrep-lem':
    ensure  => running,
    enable  => true,
    require => File[$dict_path],
  }
}
